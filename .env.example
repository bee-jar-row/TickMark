# Copy to .env (in the project root) and change what you need. Every value has a default.

# Port of the API server (and of the whole app in production)
PORT=3000

# Where the SQLite database is kept (relative to the project root)
DATA_DIR=server/data

# Frontend address(es) allowed to call the API during development (comma separated)
CORS_ORIGIN=http://localhost:5173

# How often the alert scheduler looks for tasks that passed their start-by time
ALERT_CHECK_SECONDS=30

# Web Push (VAPID). Leave empty: the server makes keys on first start and keeps them in the database.
# To fix them yourself, run:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Frontend only: set when the API runs on a different host than the web app (e.g. https://api.example.com)
# VITE_API_URL=
